              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Fresh Market\",\n  \"slug\": \"Fresh Market\",\n  \"business_mode\": \"product\",\n  \"primary_language\": \"en\",\n  \"currency_code\": \"USD\",\n  \"timezone\": \"Asia/Hebron\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/admin/tenants",
              "host": ["{{base_url}}"],
              "path": ["admin", "tenants"]
            },
            "description": "POST /api/v1/admin/tenants"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "var json = pm.response.json();",
                  "if (json && json.success && json.data && json.data.tenant && json.data.tenant.id) {",
                  "  pm.environment.set('tenant_id', String(json.data.tenant.id));",
                  "}"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "201 Tenant created",
              "originalRequest": {
                "method": "POST",
                "header": [
                  { "key": "Accept", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{token}}" },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "url": { "raw": "{{base_url}}/admin/tenants" },
                "body": { "mode": "raw", "raw": "{\n  \"name\": \"Fresh Market\",\n  \"slug\": \"Fresh Market\",\n  \"business_mode\": \"product\",\n  \"primary_language\": \"en\",\n  \"currency_code\": \"USD\",\n  \"timezone\": \"Asia/Hebron\"\n}" }
              },
              "status": "Created",
