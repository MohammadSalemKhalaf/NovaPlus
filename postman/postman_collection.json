              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": true,\n  \"message\": \"Logout successful.\",\n  \"data\": {},\n  \"meta\": {}\n}"
            },
            {
              "name": "401 Unauthenticated",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Accept", "value": "application/json" }],
                "url": { "raw": "{{base_url}}/admin/auth/logout" }
              },
              "status": "Unauthorized",
              "code": 401,
