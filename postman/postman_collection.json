{
  "info": {
    "_postman_id": "b2d9b84b-0f2d-4f10-8a4b-9a0b0c2db1a0",
    "name": "NovaPlus Phase 1 - Admin API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Phase 1 Admin APIs (Auth + Tenant Core). Base URL: {{base_url}}"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@novaplus.test\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/admin/auth/login",
              "host": ["{{base_url}}"],
              "path": ["admin", "auth", "login"]
            },
            "description": "POST /api/v1/admin/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "if (json && json.success && json.data && json.data.token) {",
                  "  pm.environment.set('token', json.data.token);",
                  "}",
                  "if (json && json.success && json.data && json.data.tenants && json.data.tenants.length > 0) {",
                  "  pm.environment.set('tenant_id', String(json.data.tenants[0].id));",
                  "}"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "200 Login successful",
              "originalRequest": {
                "method": "POST",
                "header": [
                  { "key": "Accept", "value": "application/json" },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "url": { "raw": "{{base_url}}/admin/auth/login" },
                "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@novaplus.test\",\n  \"password\": \"password123\"\n}" }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": true,\n  \"message\": \"Login successful.\",\n  \"data\": {\n    \"token\": \"1|plain-text-sanctum-token\",\n    \"user\": {\n      \"id\": 1,\n      \"name\": \"Test Admin\",\n      \"email\": \"admin@novaplus.test\"\n    },\n    \"tenants\": [\n      {\n        \"id\": 10,\n        \"name\": \"NovaPlus Demo\",\n        \"slug\": \"novaplus-demo\",\n        \"role\": \"owner\"\n      }\n    ]\n  },\n  \"meta\": {}\n}"
            },
            {
              "name": "422 Validation failed",
              "originalRequest": {
                "method": "POST",
                "header": [
                  { "key": "Accept", "value": "application/json" },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "url": { "raw": "{{base_url}}/admin/auth/login" },
                "body": { "mode": "raw", "raw": "{\n  \"email\": \"\",\n  \"password\": \"\"\n}" }
              },
              "status": "Unprocessable Entity",
              "code": 422,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": false,\n  \"message\": \"Validation failed.\",\n  \"errors\": {\n    \"email\": [\"The email field is required.\"],\n    \"password\": [\"The password field is required.\"]\n  }\n}"
            },
            {
              "name": "401 Invalid credentials",
              "originalRequest": {
                "method": "POST",
                "header": [
                  { "key": "Accept", "value": "application/json" },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "url": { "raw": "{{base_url}}/admin/auth/login" },
                "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@novaplus.test\",\n  \"password\": \"wrong-password\"\n}" }
              },
              "status": "Unauthorized",
              "code": 401,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": false,\n  \"message\": \"Invalid credentials.\"\n}"
            }
          ]
        },
