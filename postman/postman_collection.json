              "body": "{\n  \"success\": true,\n  \"message\": \"Tenant fetched successfully.\",\n  \"data\": {\n    \"tenant\": {\n      \"id\": 10,\n      \"name\": \"Fresh Market\",\n      \"slug\": \"fresh-market\",\n      \"business_mode\": \"product\",\n      \"primary_language\": \"en\",\n      \"currency_code\": \"USD\",\n      \"timezone\": \"Asia/Hebron\",\n      \"onboarding_completed_at\": null\n    }\n  },\n  \"meta\": {}\n}"
