              "status": "Not Found",
              "code": 404,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": false,\n  \"message\": \"Tenant not found.\"\n}"
            },
            {
              "name": "403 Not authorized for tenant",
              "originalRequest": {
                "method": "GET",
                "header": [
                  { "key": "Accept", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{token}}" },
                  { "key": "X-Tenant-ID", "value": "10" }
                ],
                "url": { "raw": "{{base_url}}/admin/tenants/current" }
              },
              "status": "Forbidden",
              "code": 403,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
