                "url": { "raw": "{{base_url}}/admin/tenants/current" }
              },
              "status": "Unprocessable Entity",
              "code": 422,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": false,\n  \"message\": \"Tenant context is required.\",\n  \"errors\": {\n    \"X-Tenant-ID\": [\"The X-Tenant-ID header is required.\"]\n  }\n}"
